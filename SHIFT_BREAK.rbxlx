				Description = "+2 Tragfähigkeit pro Stufe",
				Costs = { 35, 80, 150 },
				Bonuses = { 2, 4, 6 },
			},
			Speed = {
				DisplayName = "PHASEN-SCHUHE",
				Description = "+1.5 Lauftempo pro Stufe",
				Costs = { 40, 90, 165 },
				Bonuses = { 1.5, 3, 4.5 },
			},
			Pulse = {
				DisplayName = "PULS-KERN",
				Description = "−1 Sekunde Puls-Cooldown pro Stufe",
