          <string name="Source"><![CDATA[local Config = {
	GameName = "SHIFT//BREAK",
	DataStoreName = "ShiftBreakProfiles_v1",
	MinimumPlayers = 1,

	Round = {
		IntermissionDuration = 15,
		WaveDuration = 70,
		WaveClearDuration = 6,
		ResultDuration = 8,
		Waves = 3,
		ShiftInterval = 22,
