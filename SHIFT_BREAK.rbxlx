				Bonuses = { 1, 2, 3 },
			},
		},
	},

	Tags = {
		LobbySpawn = "SB_LobbySpawn",
		PlayerSpawn = "SB_PlayerSpawn",
		EchoSpawn = "SB_EchoSpawn",
		EnemySpawn = "SB_EnemySpawn",
		DepositAnchor = "SB_DepositAnchor",
		StableOnly = "SB_StableOnly",
