							<ProtectedString name="Source"><![CDATA[type side = "top" | "top-right" | "bottom-right" | "bottom" | "bottom-left" | "top-left"

type upgradeRequirement = {
	currency:string,
	amount:number,
}

type upgrades = {
	id:string,
	name:string,
	description:string,
	side:side,
