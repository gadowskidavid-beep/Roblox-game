		back.Position = Vector3.new(pos.x, 2.25, pos.z - 1.05)
		back.Parent = lobbyFolder
	end

	-- ===== LAMP POSTS (6 around the perimeter) =====
	local lampPositions = {
		{ x = LOBBY_CENTER_X - 35, z = LOBBY_CENTER_Z - 35 },
		{ x = LOBBY_CENTER_X + 35, z = LOBBY_CENTER_Z - 35 },
		{ x = LOBBY_CENTER_X - 35, z = LOBBY_CENTER_Z + 35 },
		{ x = LOBBY_CENTER_X + 35, z = LOBBY_CENTER_Z + 35 },
		{ x = LOBBY_CENTER_X - 40, z = LOBBY_CENTER_Z },
		{ x = LOBBY_CENTER_X + 40, z = LOBBY_CENTER_Z },
