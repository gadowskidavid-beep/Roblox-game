						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	PetData.lua - Pet and Egg definitions for Battle Pets
	Defines all pets with their stats and egg types with weighted pet pools.
]]

