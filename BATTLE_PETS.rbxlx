			{ petId = "Inferno", weight = 15 },
		},
	},
	WeltraumEgg = {
		name = "Weltraum Egg",
		zone = 8,
		petPool = {
			{ petId = "Cosmic", weight = 30 },
			{ petId = "Nova", weight = 20 },
			{ petId = "Nimbus", weight = 20 },
			{ petId = "Zephyr", weight = 15 },
