	-- Shop awning support poles
	local shopPole1 = Instance.new("Part")
	shopPole1.Name = "ShopPole1"
	shopPole1.Shape = Enum.PartType.Cylinder
	shopPole1.Size = Vector3.new(6, 0.5, 0.5)
