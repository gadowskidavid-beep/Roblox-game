	shopCounter.Name = "ShopCounter"
	shopCounter.Shape = Enum.PartType.Block
	shopCounter.Size = Vector3.new(8, 3, 4)
	shopCounter.Position = Vector3.new(shopX, 1.5, shopZ)
	shopCounter.Anchored = true
