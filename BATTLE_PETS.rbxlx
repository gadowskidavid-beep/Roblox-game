		petPool = {
			{ petId = "Buddy", weight = 70 },
			{ petId = "Whiskers", weight = 30 },
		},
	},
	PremiumEgg = {
		name = "Premium Egg",
		zone = 2,
		petPool = {
			{ petId = "Buddy", weight = 40 },
			{ petId = "Whiskers", weight = 30 },
			{ petId = "Blaze", weight = 20 },
			{ petId = "Inferno", weight = 10 },
		},
	},
}

return PetData
]]></ProtectedString>
