	qbText.Text = "QUESTS"
	qbText.TextColor3 = Color3.fromRGB(255, 220, 100)
	qbText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	qbText.TextStrokeTransparency = 0.3
	qbText.Font = Enum.Font.GothamBold
