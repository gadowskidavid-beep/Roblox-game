		rarity = "Rare",
		baseDamage = 15,
		baseSpeed = 8,
		modelDescription = "A small red dragon with tiny wings and glowing orange scales",
	},
	Inferno = {
		name = "Inferno",
		species = "Phoenix",
		rarity = "Legendary",
		baseDamage = 30,
		baseSpeed = 14,
		modelDescription = "A majestic golden phoenix wreathed in bright flames",
	},
}

-- Egg type definitions
PetData.Eggs = {
	BasicEgg = {
		name = "Basic Egg",
