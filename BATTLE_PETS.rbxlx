			{ bonus = 2.0 },
		},
		-- 5 hours, 12 hours, 48 hours (in seconds)
		levelRequirements = { 18000, 43200, 172800 },
	},

	-- === LEVEL QUESTS ===
	Rising = {
		id = "Rising",
		displayName = "Rising Star",
		description = "Reach higher player levels",
		icon = "⭐",
		color = { 255, 220, 50 },
		requirement = {
			type = "reachLevel",
			count = 10,
			displayText = "Reach Level 10",
		},
		levels = {
			{ bonus = 1.2 },
			{ bonus = 1.5 },
