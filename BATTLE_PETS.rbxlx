		},
		levels = {
			{ bonus = 1.2 },
			{ bonus = 1.5 },
			{ bonus = 2.0 },
		},
		levelRequirements = { 10000, 50000, 100000 },
	},

	-- === PLAYTIME QUESTS ===
	Dedication = {
		id = "Dedication",
		displayName = "Dedication",
		description = "Play the game for a long time",
		icon = "⏰",
